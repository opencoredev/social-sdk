{
  "name": "social-sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:node": "node --experimental-sqlite --import tsx --test packages/social-sdk/tests/*.test.ts",
    "lint": "turbo run lint && oxlint . && bun scripts/check-lint-policy.ts",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "check": "bun run lint && bun run format:check && bun run check-types && bun run test && bun run rebrand:check",
    "changeset": "changeset",
    "version-packages": "changeset version && oxfmt --write packages/social-sdk/CHANGELOG.md && bun install --lockfile-only",
    "rebrand:check": "bun scripts/check-rebrand.ts",
    "anti-slop:bundle": "bun scripts/build-anti-slop-bundle.ts",
    "release:gate": "bun scripts/release-gate.ts",
    "release": "bun scripts/publish.ts",
    "pack:check": "bun scripts/check-package.ts",
    "benchmark": "bun scripts/benchmark.ts",
    "benchmark:media": "node --expose-gc scripts/benchmark-media.mjs",
    "recipes:check": "tsc -p skills/integrate-social-sdk/tsconfig.json && tsc -p examples/tsconfig.json && node --import tsx --test skills/integrate-social-sdk/references/integration.test.ts examples/snippets/managed-backends.test.ts && node --import tsx examples/snippets/pagination.ts",
    "release:ci": "bun run release:gate"
  },
  "devDependencies": {
    "@atproto/oauth-client-node": "0.5.7",
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^2.31.1",
    "@opencoredev/social-sdk": "workspace:*",
    "@oxlint/plugins": "1.83.0",
    "@social-sdk/config": "workspace:*",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.46.0",
    "oxlint": "1.83.0",
    "tsx": "^4.20.6",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hono/node-server@>=2.0.0 <2.1.3": "2.1.3",
    "@modelcontextprotocol/sdk@>=1.10.0 <1.32.0": "1.32.0",
    "dompurify@<3.4.17": "3.4.17",
    "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
    "glob@>=13.0.0 <14.0.2": "14.0.2",
    "hono@>=4.12.4 <4.13.11": "4.13.11",
    "ip-address@>=10.0.0 <10.7.4": "10.7.4",
    "katex@>=0.11.0 <0.18.2": "0.18.2",
    "lodash-es@<4.18.0": "4.18.0",
    "minimatch@>=5.0.0 <11.0.1": "11.0.1",
    "path-to-regexp@>=4.0.0 <6.3.0": "6.3.0",
    "postcss-selector-parser@>=6.0.0 <6.1.5": "6.1.5",
    "qs@>=6.7.0 <6.16.1": "6.16.1",
    "sharp@<0.35.5": "0.35.5",
    "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
    "tinypool@<2.1.2": "2.1.2",
    "undici@>=6.0.0 <6.29.1": "6.29.1",
    "undici@>=7.0.0 <7.30.1": "7.30.1",
    "undici@>=8.0.0 <8.12.2": "8.12.2",
    "vite@>=8.3.0 <8.3.3": "8.3.3"
  },
  "packageManager": "bun@1.4.2"
}
