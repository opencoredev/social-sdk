{
  "name": "social-sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:node": "node --import tsx --test packages/social-sdk/tests/*.test.ts",
    "lint": "turbo run lint && oxlint .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "check": "bun run lint && bun run format:check && bun run check-types && bun run test && bun run rebrand:check",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "rebrand:check": "bun scripts/check-rebrand.ts",
    "anti-slop:bundle": "bun scripts/build-anti-slop-bundle.ts",
    "release:gate": "bun scripts/release-gate.ts",
    "release": "bun scripts/publish.ts",
    "pack:check": "bun scripts/check-package.ts",
    "benchmark": "bun scripts/benchmark.ts",
    "benchmark:media": "node --expose-gc scripts/benchmark-media.mjs",
    "recipes:check": "tsc -p skills/integrate-social-sdk/tsconfig.json && tsc -p examples/tsconfig.json && node --import tsx --test skills/integrate-social-sdk/references/integration.test.ts && node --import tsx examples/snippets/pagination.ts",
    "release:ci": "bun run release:gate"
  },
  "devDependencies": {
    "@atproto/oauth-client-node": "0.5.7",
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^2.31.1",
    "@opencoredev/social-sdk": "workspace:*",
    "@oxlint/plugins": "1.83.0",
    "@shadcn/lint": "0.2.0",
    "@social-sdk/config": "workspace:*",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.46.0",
    "oxlint": "1.83.0",
    "tsx": "^4.20.6",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
