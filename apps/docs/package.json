{
  "name": "@social-sdk/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "blume dev --host 0.0.0.0 --port 4000",
    "build": "ASTRO_TELEMETRY_DISABLED=1 blume build && bun ../../scripts/prune-docs-output.ts",
    "check-types": "blume check --strict",
    "validate": "blume validate --strict",
    "audit": "blume audit --fail-on warning",
    "preview": "blume preview --host 0.0.0.0 --port 4000",
    "test": "bun test pages/_blog"
  },
  "devDependencies": {
    "astro": "7.3.3",
    "blume": "2.0.3"
  }
}
