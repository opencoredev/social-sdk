{
  "name": "@opencoredev/social-sdk-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "test": "bun test tests"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.1.0",
    "@opencoredev/social-sdk": "workspace:*",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
